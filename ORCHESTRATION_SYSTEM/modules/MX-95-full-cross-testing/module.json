{
  "schema_version": "memoryx.orchestration-module.v1",
  "id": "MX-95",
  "slug": "full-cross-testing",
  "display_name": "Full and Cross-Tool Testing",
  "responsibility": "Own the fail-closed inventory and isolated direct/cross-tool runtime audit of every published MemoryX MCP operation without editing production Rust.",
  "path": "ORCHESTRATION_SYSTEM/modules/MX-95-full-cross-testing",
  "base": {
    "scope": "project-local",
    "name": "mx-95-full-cross-testing",
    "path": ".memoryx/bases/mx-95-full-cross-testing",
    "max_mutable_owners": 1
  },
  "execution": {
    "model": "gpt-5.6-sol",
    "reasoning_effort": "xhigh",
    "forbidden_reasoning_effort": [
      "max"
    ],
    "reassert_on_start_resume": true
  },
  "session": {
    "binding_file": "session_id.txt",
    "initial_state": "UNBOUND",
    "resume_only_when_bound": true,
    "never_synthesize_uuid": true
  },
  "ownership": {
    "owned_paths": [
      "ORCHESTRATION_SYSTEM/modules/MX-95-full-cross-testing/"
    ],
    "shared_surfaces": [
      "MCP tool contracts with MX-70",
      "schemas and migrations with MX-80",
      "conformance and release handoff with MX-90"
    ],
    "forbidden_paths": [
      "src/",
      "tests/",
      "benches/",
      "benchmarks/",
      ".github/workflows/"
    ]
  },
  "canonical_refs": [
    "Concept/SKF.txt",
    "Concept/SKF-1.1 Implementer-Ready Spec.txt",
    "Concept/Расширение.txt",
    "CONCEPT_EXTENSION_IMPLEMENTATION_PLAN.md",
    "ORCHESTRATION_PLAN.md",
    "README.md",
    "docs/LIVE_OWNER_CONTROL.md"
  ],
  "dossiers": [
    "DOSSIERS/TOOL_INVENTORY.md",
    "DOSSIERS/CROSS_TOOL_MATRIX.md",
    "DOSSIERS/TEST_EVIDENCE.md"
  ],
  "hooks": {
    "session_start": "hooks/SessionStart.ps1",
    "pre_compact": "hooks/PreCompact.ps1",
    "post_compact": "hooks/PostCompact.ps1"
  },
  "evidence_return_schema": "../../schemas/evidence-return.schema.json"
}
