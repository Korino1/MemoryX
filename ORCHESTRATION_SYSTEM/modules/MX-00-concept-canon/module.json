{
  "schema_version": "memoryx.orchestration-module.v1",
  "id": "MX-00",
  "slug": "concept-canon",
  "display_name": "Concept and SKF Canon",
  "responsibility": "Govern the frozen MemoryX concept and trace implementation claims to canonical requirements without editing production Rust.",
  "path": "ORCHESTRATION_SYSTEM/modules/MX-00-concept-canon",
  "base": {
    "scope": "project-local",
    "name": "mx-00-concept-canon",
    "path": ".memoryx/bases/mx-00-concept-canon",
    "max_mutable_owners": 1
  },
  "execution": {
    "model": "gpt-5.6-sol",
    "reasoning_effort": "xhigh",
    "forbidden_reasoning_effort": [
      "max"
    ],
    "reassert_on_start_resume": true
  },
  "session": {
    "binding_file": "session_id.txt",
    "initial_state": "UNBOUND",
