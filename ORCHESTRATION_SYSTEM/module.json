{
  "schema_version": "memoryx.orchestration-module.v1",
  "id": "MX-ROOT",
  "slug": "root-orchestrator",
  "display_name": "MemoryX Root Orchestrator",
  "responsibility": "Route bounded work through the manifest registry, coordinate ownership and resources, and preserve concept and roadmap authority.",
  "path": "ORCHESTRATION_SYSTEM",
  "base": {
    "scope": "project-local",
    "name": "memoryx",
    "path": ".memoryx/bases/memoryx",
    "max_mutable_owners": 1
  },
  "execution": {
    "model": "gpt-5.6-sol",
    "reasoning_effort": "xhigh",
    "forbidden_reasoning_effort": [
      "max"
    ],
    "reassert_on_start_resume": true
  },
  "session": {
    "binding_file": "session_id.txt",
    "initial_state": "UNBOUND",
    "resume_only_when_bound": true,
    "never_synthesize_uuid": true
  },
  "ownership": {
    "owned_paths": [
      "ORCHESTRATION_SYSTEM/"
    ],
    "shared_surfaces": [
      "cross-module handoffs",
      "root validation",
      "release acceptance routing"
    ],
    "forbidden_paths": [
      "unreviewed production implementation",
      "module-local physical bases"
    ]
  },
  "canonical_refs": [
    "Concept/SKF.txt",
    "Concept/SKF-1.1 Implementer-Ready Spec.txt",
    "Concept/Расширение.txt",
    "CONCEPT_EXTENSION_IMPLEMENTATION_PLAN.md",
    "ORCHESTRATION_PLAN.md"
  ],
  "dossiers": [
    "DOSSIERS/ROUTING.md",
    "DOSSIERS/RECOVERY.md"
  ],
  "hooks": {
    "session_start": "hooks/SessionStart.ps1",
    "pre_compact": "hooks/PreCompact.ps1",
    "post_compact": "hooks/PostCompact.ps1"
  },
  "evidence_return_schema": "schemas/evidence-return.schema.json"
}
